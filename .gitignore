# Ignorar solo el entorno virtual
venv/
.venv/
env/

# Ignorar variables de entorno (seguridad)
.env
.env.local
.env.production

# Bytecode compilado — no debe versionarse (binario, específico de
# intérprete/plataforma, se regenera solo)
__pycache__/
*.py[cod]

# Artefactos locales
db.sqlite3
staticfiles/
*.log
